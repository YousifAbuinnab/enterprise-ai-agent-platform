# Environment (copy to .env and fill in real values)

# Application
APP_NAME=Enterprise AI Agent Platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=enterprise_ai_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM provider (used by app/services/llm_client.py)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
